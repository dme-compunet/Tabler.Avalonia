<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>preview</LangVersion>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.5" />
		<PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
		<!-- Developer Tools hook (replaces the deprecated Avalonia.Diagnostics package). -->
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
		<!-- SukiUI consumed as a NuGet package (not a submodule). -->
		<PackageReference Include="SukiUI" Version="7.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tabler.Avalonia\Tabler.Avalonia.csproj" />
	</ItemGroup>
</Project>

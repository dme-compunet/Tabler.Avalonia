<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- Shared with the runtime decoder so both sides always use the same format. -->
		<Compile Include="..\..\Tabler.Avalonia\IconPathCodec.cs" Link="Shared\IconPathCodec.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SvgToXaml.Converter" Version="11.2.0" />
		<!-- SvgToXaml only brings the Windows/macOS native Skia; CI regenerates icons on Linux. -->
		<PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
	</ItemGroup>

</Project>
